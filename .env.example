# Copy to .env for local development. Change the password outside a local workstation.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=russia_map
POSTGRES_USER=russia_map
POSTGRES_PASSWORD=local_dev_only

MARTIN_PORT=3000
# Browser paths, proxied by Vite during development.
VITE_API_URL=/api
VITE_TILE_URL=/tiles
# Upstream targets used by the Vite development server.
API_PROXY_TARGET=http://127.0.0.1:8000
MARTIN_PROXY_TARGET=http://127.0.0.1:3000
